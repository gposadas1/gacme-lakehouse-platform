# Copy to bootstrap/dev.env (gitignored) and edit. Names only: IDs are looked up at run time.

SUBSCRIPTION=gacme-data-platform-dev
LOCATION=westus2

GITHUB_OWNER=gposadas1
GITHUB_REPO=gacme-lakehouse-platform

# CI identity for this environment (app registration display name)
APP_NAME=sp-gacme-github-dev

# Remote state, in this environment's subscription
# dev reuses the state storage created before the gacme naming (storage accounts can't be renamed).
TFSTATE_RG=rg-gdbxlab-tfstate
TFSTATE_SA=gdbxlabtfstate24367
TFSTATE_CONTAINER=tfstate

# true: this identity also trusts pull_request tokens, so PRs can run plan (dev only)
PR_PLAN=true

# GitHub user who must approve deployments to this environment (empty: no approval gate)
REQUIRED_REVIEWER=
