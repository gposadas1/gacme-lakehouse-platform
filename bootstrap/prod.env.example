# Copy to bootstrap/prod.env (gitignored) and edit. Names only: IDs are looked up at run time.

SUBSCRIPTION=gacme-data-platform-prod
LOCATION=westus2

GITHUB_OWNER=gposadas1
GITHUB_REPO=gacme-lakehouse-platform

# CI identity for this environment (app registration display name)
APP_NAME=sp-gacme-github-prod

# Remote state, in this environment's subscription
# Storage account names are global, 3-24 lowercase letters and digits: replace the zeros.
TFSTATE_RG=rg-gacme-tfstate-prod
TFSTATE_SA=stgacmetfstateprod00000
TFSTATE_CONTAINER=tfstate

# true: this identity also trusts pull_request tokens, so PRs can run plan (dev only)
PR_PLAN=false

# GitHub user who must approve deployments to this environment (empty: no approval gate).
# Required reviewers need a public repository (or GitHub Enterprise); leave empty while private.
REQUIRED_REVIEWER=
